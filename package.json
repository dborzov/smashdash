{
  "name": "smashdash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Smashdash: a story-driven RPG that teaches algebra, equations and powers of ten to curious kids.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && npm run validate",
    "validate": "vitest run tests/content.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "ci": "npm run check && npm test && vite build"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "katex": "^0.19.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  }
}
